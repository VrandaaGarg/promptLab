# ─── Database ────────────────────────────────────────────────
# Neon Postgres connection string (use the pooled URL)
# e.g. postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/promptlab?sslmode=require
DATABASE_URL=

# ─── AI ──────────────────────────────────────────────────────
# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Auth (Better Auth) ──────────────────────────────────────
# Random secret, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# ─── Limits ──────────────────────────────────────────────────
# Maximum number of runs a single user can start per hour
RUNS_PER_HOUR=20
